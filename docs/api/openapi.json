{
  "components": {
    "schemas": {
      "AgentChatRequest": {
        "description": "A single message submitted to the arithmetic agent.",
        "properties": {
          "message": {
            "description": "Question or instruction for the arithmetic assistant.",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "AgentChatRequest",
        "type": "object"
      },
      "AgentChatResponse": {
        "description": "The agent's final user-facing answer.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "AgentChatResponse",
        "type": "object"
      },
      "AgentHistoryResponse": {
        "description": "A page of persisted agent turns.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AgentQueryResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "AgentHistoryResponse",
        "type": "object"
      },
      "AgentQueryResponse": {
        "description": "One persisted question, answer, timestamp pair, and tool activity.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "input_at": {
            "format": "date-time",
            "title": "Input At",
            "type": "string"
          },
          "output_at": {
            "format": "date-time",
            "title": "Output At",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "tools_used": {
            "items": {
              "$ref": "#/components/schemas/AgentToolUsage"
            },
            "title": "Tools Used",
            "type": "array"
          }
        },
        "required": [
          "id",
          "question",
          "answer",
          "input_at",
          "output_at",
          "tools_used"
        ],
        "title": "AgentQueryResponse",
        "type": "object"
      },
      "AgentToolUsage": {
        "description": "A tool invoked while producing an agent answer.",
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "result": {
            "title": "Result"
          }
        },
        "required": [
          "name",
          "arguments"
        ],
        "title": "AgentToolUsage",
        "type": "object"
      },
      "EchoRequest": {
        "description": "Text submitted by a client to verify API connectivity.",
        "properties": {
          "message": {
            "description": "Message to echo back to the caller.",
            "examples": [
              "Hello from Feature Studio"
            ],
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "EchoRequest",
        "type": "object"
      },
      "EchoResponse": {
        "description": "Acknowledgement returned by the API.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "message",
          "received_at"
        ],
        "title": "EchoResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Feature Studio API. Each product feature owns its routes, schemas, and application services.",
    "title": "Feature Studio API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Returns links to the API documentation and health endpoint.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "API overview",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/agentic-ai/chat": {
      "post": {
        "description": "Generate and persist the answer for a single message.",
        "operationId": "chat_api_v1_agentic_ai_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ask the arithmetic assistant",
        "tags": [
          "agentic-ai"
        ]
      }
    },
    "/api/v1/agentic-ai/history": {
      "get": {
        "description": "Return persisted turns, newest first, for viewing in Swagger.",
        "operationId": "history_api_v1_agentic_ai_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentHistoryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List saved agent turns",
        "tags": [
          "agentic-ai"
        ]
      }
    },
    "/api/v1/examples/echo": {
      "post": {
        "description": "Validate a short message and return it with a request ID and UTC timestamp. This demonstration endpoint does not persist data.",
        "operationId": "post_echo_api_v1_examples_echo_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Echo a message",
        "tags": [
          "echo"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Confirms that the API process is responding.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Check Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health check",
        "tags": [
          "health"
        ]
      }
    }
  }
}
